<Window x:Class="TransparentCalendar.Views.DayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日记录"
        Width="420"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Margin="8"
            Padding="18"
            CornerRadius="12"
            Background="#B41A1A1A"
            BorderBrush="#55FFFFFF"
            BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Button Width="28"
                    Height="28"
                    Padding="0"
                    DockPanel.Dock="Right"
                    Style="{StaticResource GhostButtonStyle}"
                    ContentTemplate="{StaticResource CloseIconTemplate}"
                    ToolTip="关闭（Esc）"
                    Click="Cancel_Click"/>
            <TextBlock x:Name="DateTitle"
                       FontSize="22"
                       Foreground="White"
                       FontWeight="Light"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DialogSectionTitle}" Margin="0,4,0,8" Text="待办"/>
            <ItemsControl x:Name="TodoItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="80"/>
                                <TextBlock Text="{Binding PostponedLabel}"
                                           Foreground="#CCFFD166"
                                           FontSize="11"
                                           Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PostponedLabel}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <ComboBox Grid.Column="2"
                                      Width="64"
                                      Margin="0,0,2,0"
                                      VerticalAlignment="Center"
                                      SelectedValue="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="普通"/>
                                <ComboBoxItem Content="重要"/>
                            </ComboBox>
                            <Button Grid.Column="3"
                                    Content="推迟"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Click="PostponeTodo_Click"
                                    ToolTip="推迟到次日，点保存后才生效">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="4"
                                    Content="删除"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Click="DeleteTodo_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="添加待办"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="AddTodo_Click"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,14" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Style="{StaticResource DialogSectionTitle}"
                       Margin="0,0,0,8"
                       Text="日记"/>
            <TextBox x:Name="DiaryText"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Padding="10,6"
                     Style="{StaticResource OverlayTextBoxStyle}"/>
        </DockPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消"
                    Style="{StaticResource GhostButtonStyle}"
                    IsCancel="True"
                    Width="76"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="保存"
                    IsDefault="True"
                    Width="76"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
