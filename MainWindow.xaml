<Window x:Class="TransparentCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="透明日历"
        Width="760"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="CellScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7"/>
                            <Border x:Name="HoverLayer"
                                    Background="#24FFFFFF"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="CellScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.025"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="CellScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.025"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="CellScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="CellScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarModeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar"
                Margin="10,6,10,0"
                Padding="10,4"
                CornerRadius="8"
                Background="#50181818"
                BorderBrush="#38FFFFFF"
                BorderThickness="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="PrevMonthBtn" Content="‹" Width="28" Height="28" Click="PreviousMonth_Click" Style="{StaticResource NavButtonStyle}"/>
                    <TextBlock x:Name="MonthTitle" Margin="10,0" MinWidth="120" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Light" FontSize="20"/>
                    <Button x:Name="NextMonthBtn" Content="›" Width="28" Height="28" Click="NextMonth_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="SettingsBtn" Content="设置" MinWidth="44" Height="28" Click="Settings_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="CloseBtn" Content="×" Width="28" Height="28" Margin="4,0,0,0" Click="Close_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="10,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="68"/>
                <ColumnDefinition x:Name="MainContentColumn" Width="*"/>
                <ColumnDefinition x:Name="RightSidebarColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ModeSidebar"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="6"
                    CornerRadius="8"
                    Background="#55181818"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1">
                <StackPanel>
                    <Button x:Name="CalendarModeButton"
                            Content="月历"
                            Style="{StaticResource SidebarModeButtonStyle}"
                            Click="CalendarMode_Click"/>
                    <Button x:Name="ListModeButton"
                            Content="待做"
                            Style="{StaticResource SidebarModeButtonStyle}"
                            Click="ListMode_Click"/>
                    <Button x:Name="NoteModeButton"
                            Content="笔记"
                            Style="{StaticResource SidebarModeButtonStyle}"
                            Click="NoteMode_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="MainContentPanel"
                    Grid.Column="1"
                    Padding="10"
                    CornerRadius="8"
                    Background="#50181818"
                    BorderBrush="#38FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                        <TextBlock Text="搜索"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#CCFFFFFF"/>
                        <TextBox x:Name="SearchTextBox"
                                 Height="30"
                                 MinWidth="180"
                                 VerticalContentAlignment="Center"
                                 Background="#22FFFFFF"
                                 Foreground="White"
                                 BorderBrush="#40FFFFFF"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Border x:Name="CalendarViewPanel"
                                Padding="8"
                                CornerRadius="7"
                                Background="#22181818"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <UniformGrid x:Name="WeekHeaderGrid" Grid.Row="0" Columns="7" Margin="2,0,2,4"/>

                                <Border x:Name="TodayTodoPanel"
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="#33181818"
                                        Visibility="Collapsed">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock x:Name="TodayTodoTitle"
                                                   Text="今日待办"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Normal"/>
                                        <WrapPanel x:Name="TodayTodoItems"/>
                                    </DockPanel>
                                </Border>

                                <Grid x:Name="CalendarGrid" Grid.Row="2" Margin="0"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ListViewPanel"
                                Padding="10"
                                CornerRadius="7"
                                Background="#33181818"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ListContentPanel"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="WebNoteViewPanel"
                                Padding="10"
                                CornerRadius="7"
                                Background="#33181818"
                                BorderBrush="#30FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="网页笔记"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Light"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="AddNoteButton"
                                            Content="+ 添加"
                                            MinWidth="60"
                                            Height="28"
                                            DockPanel.Dock="Right"
                                            Click="AddNote_Click"/>
                                </DockPanel>
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="8,6"
                                        CornerRadius="5"
                                        Background="#22181818"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="方式1：书签划线 - 复制下面代码到浏览器书签的网址栏（推荐Chrome/Edge）：
方式2: 安装扩展 - 打开 chrome://extensions , 开启开发者模式, 点加载解压缩的扩展, 选择 BrowserExtension 文件夹"
                                                   Foreground="#BBFFFFFF"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="BookmarkletText"
                                                   Text="等待启动..."
                                                   Foreground="#FFD166"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WebNoteListPanel"/>
                                </ScrollViewer>

                                <Border x:Name="NoteEditorPanel"
                                        Grid.Row="3"
                                        Padding="10"
                                        CornerRadius="6"
                                        Background="#44181818"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="NoteTitleInput"
                                                 Grid.Row="0"
                                                 Height="30"
                                                 Margin="0,0,0,6"
                                                 VerticalContentAlignment="Center"
                                                 Background="#22FFFFFF"
                                                 Foreground="White"
                                                 BorderBrush="#40FFFFFF"/>
                                        <TextBox x:Name="NoteUrlInput"
                                                 Grid.Row="1"
                                                 Height="30"
                                                 Margin="0,0,0,6"
                                                 VerticalContentAlignment="Center"
                                                 Background="#22FFFFFF"
                                                 Foreground="White"
                                                 BorderBrush="#40FFFFFF"/>
                                        <TextBox x:Name="NoteContentInput"
                                                 Grid.Row="2"
                                                 Height="80"
                                                 Margin="0,0,0,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Background="#22FFFFFF"
                                                 Foreground="White"
                                                 BorderBrush="#40FFFFFF"/>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="NoteEditorCancelBtn"
                                                    Content="取消"
                                                    MinWidth="52"
                                                    Height="28"
                                                    Margin="0,0,8,0"
                                                    Click="NoteEditorCancel_Click"/>
                                            <Button x:Name="NoteEditorSaveBtn"
                                                    Content="保存"
                                                    MinWidth="52"
                                                    Height="28"
                                                    Click="NoteEditorSave_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>





