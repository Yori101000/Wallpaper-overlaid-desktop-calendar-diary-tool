<Window x:Class="TransparentCalendar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="透明日历"
        Width="760"
        Height="520"
        MinWidth="480"
        MinHeight="360"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SizeChanged="MainWindow_SizeChanged"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Microsoft YaHei UI, Segoe UI, Segoe UI Variable">
    <Window.Resources>
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 填充圆角矩形这一族现在由下面的 HoverLayer 独占："今天"曾经也在这里
                                 铺填充 + 内描边，和 hover 撞得分不清，已经撤掉（改由今日块承载）。
                                 Background/BorderBrush 仍绑出来供样式默认值使用。 -->
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"/>
                            <Border x:Name="HoverLayer"
                                    Background="#20FFFFFF"
                                    BorderBrush="#4DFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 只做透明度过渡。原先还叠了 ScaleTransform 1.025，
                                 缩放会让格子里的文字重排并渲染发虚。 -->
                            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            顶栏的控件语言只有两种，别再往里加第三种：

            1) GhostButtonStyle —— 无底、无描边，只有文字或字形；hover 才浮现一块底。
               界面早已是**单层**半透明表面，按钮再各自带底色与白描边就是"盒子套盒子"的回潮，
               一排灰方块压在玻璃上正是之前难看的根源。
            2) SegmentButtonStyle —— 三个视图模式共享一个胶囊底，选中项是一块实心滑块。
               它表达的是"三选一"，与幽灵按钮表达的"点一下做件事"是两回事。
        -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <!-- 键盘可达：Tab 走到时必须看得见，幽灵按钮平时没有边界 -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 滑块用 Background 承载：选中态由 UpdateModeButtons 赋值，
                             未选中是 Transparent，胶囊底由外层 Border 统一提供。 -->
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 搜索框：WPF 默认 TextBox 自带一圈系统 chrome，在半透明浮层上与自定义按钮风格割裂。 -->
        <Style x:Key="OverlayTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#59FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条：系统默认滚动条在深色半透明底上非常突兀。改成 4px 极简滑块，
             不占布局宽度（Width 固定 8，滑块居中）。这里用隐式 Style，
             ListViewPanel 与 WebNoteViewPanel 的 ScrollViewer 都会套用。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar"
                                                        Width="4"
                                                        Background="#3DFFFFFF"
                                                        CornerRadius="2"
                                                        HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#6BFFFFFF"/>
                                                        <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Background" Value="#8AFFFFFF"/>
                                                        <Setter TargetName="Bar" Property="Width" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <!-- 轨道上下的翻页区做成透明无边框，默认模板那两个箭头按钮直接去掉 -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="Transparent" MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <!--
            整个界面只有**一块**表面：底色、边框、圆角全部由 AppSurface 承载。
            HeaderBar / ModeSidebar / MainContentPanel 一律不再自带背景与边框，
            否则又会变回"盒子套盒子"，透明度也会被层层叠加吃掉。
            ApplySettings() 只给 AppSurface 上色。
        -->
        <Border x:Name="AppSurface"
                Margin="10"
                CornerRadius="14"
                Background="#50181818"
                BorderBrush="#38FFFFFF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

        <!--
            顶栏一行承载全部"操作外壳"：左边是内容相关的月份导航，右边是模式切换与窗口操作。
            原先它们散在三处（顶栏一行、左侧栏一列 68px、搜索一行 38px），侧栏还有 ~560px
            是空的。合并之后内容区从上到下只剩今日块 / 周头 / 月历三层。
        -->
        <Border x:Name="HeaderBar" Padding="10,8,10,6">
            <Grid>
                <DockPanel x:Name="HeaderContent">
                    <!-- 月份导航：箭头贴着标题左右两侧成一组，不再是三个分离的方块。
                         非月历模式下整组隐藏 —— 待做与笔记跟月份无关。 -->
                    <StackPanel x:Name="MonthNavGroup" Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="PrevMonthBtn" Content="‹" Width="24" FontSize="17"
                                Padding="0" Click="PreviousMonth_Click"
                                Style="{StaticResource GhostButtonStyle}" ToolTip="上一月（←）"/>
                        <TextBlock x:Name="MonthTitle" Margin="2,0" VerticalAlignment="Center"
                                   FontWeight="Light" FontSize="21"/>
                        <Button x:Name="NextMonthBtn" Content="›" Width="24" FontSize="17"
                                Padding="0" Click="NextMonth_Click"
                                Style="{StaticResource GhostButtonStyle}" ToolTip="下一月（→）"/>
                        <Button x:Name="TodayBtn" Content="今天" Margin="4,0,0,0" Click="Today_Click"
                                Style="{StaticResource GhostButtonStyle}" ToolTip="回到今天（T）"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <!-- 分段控件：三个模式共享一个胶囊底，选中项是实心滑块 -->
                        <!-- 胶囊只留一层极淡的底、不加描边：它是"三选一"的容器，
                             不该比顶栏上任何一个文字都重。 -->
                        <Border x:Name="ModeSegment" CornerRadius="7" Padding="2"
                                Margin="0,0,10,0"
                                Background="#12FFFFFF"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- 窄窗口下文字会被 UpdateModeButtonLabels 收成单字，
                                     全称留在 ToolTip 里。 -->
                                <Button x:Name="CalendarModeButton" Content="月历" ToolTip="月历"
                                        Style="{StaticResource SegmentButtonStyle}" Click="CalendarMode_Click"/>
                                <Button x:Name="ListModeButton" Content="待做" ToolTip="待做"
                                        Style="{StaticResource SegmentButtonStyle}" Click="ListMode_Click"/>
                                <Button x:Name="NoteModeButton" Content="笔记" ToolTip="笔记"
                                        Style="{StaticResource SegmentButtonStyle}" Click="NoteMode_Click"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SearchToggleBtn" Width="28" Padding="0"
                                Click="SearchToggle_Click" Style="{StaticResource GhostButtonStyle}"
                                ToolTip="搜索（Ctrl+F）">
                            <!-- 放大镜用矢量画，不依赖任何图标字体 -->
                            <Canvas Width="14" Height="14">
                                <Ellipse Width="10" Height="10" Canvas.Left="0" Canvas.Top="0"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.4"/>
                                <Line X1="9" Y1="9" X2="13.2" Y2="13.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="SettingsBtn" Content="设置" Click="Settings_Click"
                                Style="{StaticResource GhostButtonStyle}"/>
                        <!-- ✕ 与「设置」之间拉开一段：它是这一行里唯一"点错就得重开"的按钮 -->
                        <Button x:Name="CloseBtn" Content="✕" Width="28" Margin="10,0,0,0" Padding="0"
                                FontSize="13" Click="Close_Click" Style="{StaticResource GhostButtonStyle}"
                                ToolTip="关闭（Esc）"/>
                    </StackPanel>
                </DockPanel>

                <!-- 搜索条：平时收起，展开时整条盖住顶栏。十次里有九次用不到，
                     不该常年占一整行。Ctrl+F 或点放大镜展开，Esc 收起。 -->
                <Border x:Name="SearchOverlay" Visibility="Collapsed"
                        Background="Transparent" VerticalAlignment="Center">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="SearchCloseBtn" Content="✕" Width="28" Padding="0" FontSize="13"
                                DockPanel.Dock="Right" Margin="6,0,0,0" Click="SearchToggle_Click"
                                Style="{StaticResource GhostButtonStyle}" ToolTip="收起搜索（Esc）"/>
                        <TextBox x:Name="SearchTextBox" Height="30"
                                 Style="{StaticResource OverlayTextBoxStyle}"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="12,0,12,10">
            <Border x:Name="MainContentPanel">
                    <Grid>
                        <!-- 底色与边框已上移到 MainContentPanel 单层承载：原先这里再叠一层
                             #22181818 + 白边，实际黑度 ≈40%，比设置里的「背景透明度」更闷。 -->
                        <Border x:Name="CalendarViewPanel"
                                Padding="4,0,4,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 周头是月历表格的列头，必须紧贴月历。原先它排在今日块**上面**，
                                     中间隔着一整块内容，列头与它标注的表格断开了。 -->
                                <UniformGrid x:Name="WeekHeaderGrid" Grid.Row="1" Columns="7" Margin="2,0,2,4"/>

                                <!--
                                    今日块。「今天」的识别任务从日期格搬到了这里 ——
                                    格子只有 ~52px 高却要塞数字/农历/圆点，再加一样标记只会更脏。
                                    这块常驻显示（不再只在有待办时出现），否则"今天"会时有时无。
                                    用提亮而非再压黑一层，避免与主面板叠加。
                                -->
                                <Border x:Name="TodayPanel"
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        Padding="12,8"
                                        CornerRadius="9"
                                        Background="#14FFFFFF">
                                    <StackPanel>
                                        <Grid>
                                            <!-- 计数/提示紧跟在日期块右边（第 2 列 Auto），最后一列吸收余量。
                                                 原先它靠在最右缘，窗口一宽就与它描述的那个大号日号断开了。 -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="TodayDayNumber"
                                                       Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Light"
                                                       Typography.NumeralAlignment="Tabular"/>

                                            <StackPanel Grid.Column="1"
                                                        Margin="11,0,8,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TodayDateLine"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                    <!-- 假日标签是唯一允许颜色参与"今天"表达的地方：
                                                         它承载的是法定属性，不是"今天"本身。 -->
                                                    <Border x:Name="TodayHolidayChip"
                                                            Margin="7,0,0,0"
                                                            Padding="5,0,5,1"
                                                            CornerRadius="5"
                                                            VerticalAlignment="Center"
                                                            Visibility="Collapsed">
                                                        <TextBlock x:Name="TodayHolidayText"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="TodayLunarLine"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TodayTodoTitle"
                                                       Grid.Column="2"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Normal"/>
                                        </Grid>

                                        <WrapPanel x:Name="TodayTodoItems" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="CalendarGrid" Grid.Row="2" Margin="0"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ListViewPanel"
                                Padding="4,0,4,0"
                                Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ListContentPanel"/>
                            </ScrollViewer>
                        </Border>

                        <Border x:Name="WebNoteViewPanel"
                                Padding="4,0,4,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="网页笔记"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Light"
                                               VerticalAlignment="Center"/>
                                    <Button x:Name="AddNoteButton"
                                            Content="+ 添加"
                                            MinWidth="60"
                                            Height="28"
                                            DockPanel.Dock="Right"
                                            Click="AddNote_Click"/>
                                </DockPanel>
                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="8,6"
                                        CornerRadius="9"
                                        Background="#22181818"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="NoteListenerStatus"
                                                   Text="检测中..."
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="方式1：书签划线 - 复制下面代码到浏览器书签的网址栏（推荐Chrome/Edge）：
方式2: 安装扩展 - 打开 chrome://extensions , 开启开发者模式, 点加载解压缩的扩展, 选择 BrowserExtension 文件夹"
                                                   Foreground="#BBFFFFFF"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="BookmarkletText"
                                                   Text="等待启动..."
                                                   Foreground="#FFD166"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="WebNoteListPanel"/>
                                </ScrollViewer>

                                <Border x:Name="NoteEditorPanel"
                                        Grid.Row="3"
                                        Padding="10"
                                        CornerRadius="9"
                                        Background="#44181818"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="NoteTitleInput"
                                                 Grid.Row="0"
                                                 Height="30"
                                                 Margin="0,0,0,8"
                                                 Style="{StaticResource OverlayTextBoxStyle}"/>
                                        <TextBox x:Name="NoteUrlInput"
                                                 Grid.Row="1"
                                                 Height="30"
                                                 Margin="0,0,0,8"
                                                 Style="{StaticResource OverlayTextBoxStyle}"/>
                                        <TextBox x:Name="NoteContentInput"
                                                 Grid.Row="2"
                                                 Height="80"
                                                 Margin="0,0,0,8"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 VerticalContentAlignment="Top"
                                                 Padding="10,6"
                                                 Style="{StaticResource OverlayTextBoxStyle}"/>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="NoteEditorCancelBtn"
                                                    Content="取消"
                                                    MinWidth="52"
                                                    Height="28"
                                                    Margin="0,0,8,0"
                                                    Click="NoteEditorCancel_Click"/>
                                            <Button x:Name="NoteEditorSaveBtn"
                                                    Content="保存"
                                                    MinWidth="52"
                                                    Height="28"
                                                    Click="NoteEditorSave_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
